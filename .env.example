# =========================================================
# Ride Booking System – Environment Variables
# Copy this file to .env and adjust values for your setup.
# .env is git-ignored; never commit real secrets.
# =========================================================

# --- PostgreSQL ------------------------------------------------
# Java services on the host connect via localhost:5432.
# If services are containerized later, set DB_HOST=postgres inside
# ride-booking-network (see docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Per-service database names (must match created databases)
# Databases are created automatically by docker compose (see
# docker-compose.yml and docker/postgres/init/01-create-databases.sql).
AUTH_DB_NAME=ride_booking
USER_DB_NAME=ride_booking
DRIVER_DB_NAME=ride_booking_driver
RIDE_DB_NAME=ride_service_db
PAYMENT_DB_NAME=payment_db
NOTIFICATION_DB_NAME=notification_db

# --- Eureka ----------------------------------------------------
EUREKA_HOSTNAME=localhost
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# --- JWT -------------------------------------------------------
# Minimum 32 bytes for HMAC-SHA256 (HS256).
# Generate with:  openssl rand -base64 48
JWT_SECRET=dev-only-change-me-this-secret-is-for-local-development-only
JWT_EXPIRATION=86400000

# --- Optional overrides ----------------------------------------
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=local
